# Canonical URL (matches metadataBase); optional in dev, recommended in prod
# NEXT_PUBLIC_SITE_URL=https://www.realtasteofafrica.com

# Public PayPal client id for the Claim / verify flow (browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Server: PayPal order creation (preferred; falls back to NEXT_PUBLIC if only one is set)
# PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to true for sandbox API + checkout
PAYPAL_SANDBOX=true

# Contact email shown/fallback across the site
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Cloudflare contact form (Email Sending + Turnstile)
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_EMAIL_API_TOKEN=token_with_email_sending_edit
# CLOUDFLARE_EMAIL_FROM=Real Taste of Africa <noreply@realtasteofafrica.com>
# CONTACT_TO_EMAIL=therealtasteofafrica@gmail.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Admin contact form submissions (optional)
# RESEND_API_KEY=
# RESEND_FROM=Real Taste of Africa <noreply@yourdomain.com>

# Protects /admin server actions — set a strong random string in production
# ADMIN_KEY=
